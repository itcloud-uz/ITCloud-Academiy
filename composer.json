{
    "name": "itcloud/ai-coding-bootcamp",
    "type": "project",
    "description": "AI-Powered Coding Bootcamp Enterprise Platform (Laravel 11 + Vue 3)",
    "keywords": ["laravel", "vue", "bootcamp", "ai", "multi-agent", "cybersecurity"],
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "predis/predis": "^2.2",
        "spatie/laravel-permission": "^6.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.18",
        "Mockery/Mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
